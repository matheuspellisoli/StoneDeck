{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "outDir": "dist",
    "rootDir": ".",
    "paths": {}
  },
  "files": [],
  "include": [],
  "references": [
    {
      "path": "./packages/core"
    },
    {
      "path": "./packages/cli"
    },
    {
      "path": "./packages/html-plugin"
    },
    {
      "path": "./packages/pdf-plugin"
    }
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/test",
    "**/tests",
    "**/*.test.ts"
  ]
}